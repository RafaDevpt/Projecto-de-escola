# PT-PT: Credenciais da base de dados. Copie para .env e preencha; o .env nunca
#        entra no repositório. O PHP lê estas variáveis do ambiente do servidor
#        web (por exemplo, SetEnv no Apache) — não carrega o ficheiro sozinho.
# EN-UK: Database credentials. Copy to .env and fill in; .env never enters the
#        repository. PHP reads these from the web server environment.
#
# Created by Redfox using Claude

DB_USER=user
DB_PASSWORD=change-me
